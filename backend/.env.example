# Local Postgres started by scripts/setup_db.sh (docker-compose.yml).
DATABASE_URL=postgresql://fireprotector:fireprotector@localhost:5432/fireprotector

# Or a hosted Postgres, e.g. Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Where the asset rows live, and which columns hold the coordinates.
ASSET_SPECS_TABLE=protection.asset_specs
LATITUDE_COLUMN=latitude
LONGITUDE_COLUMN=longitude

# Row caps for /building_specs; /assets pages at ASSETS_PAGE_SIZE.
DEFAULT_LIMIT=500
MAX_LIMIT=10000

# Connection pool sizing.
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["*"]

# Deepfire API credentials (deepfire.co). No longer read by this backend - the
# fire spread behind /fire/arrival-grid and /api is the self-hosted ELMFIRE
# pipeline below - but still passed through by docker-compose.yml for other
# Deepfire users. Without the static tier, /fire/arrival-grid answers 503 and
# /api serves whatever scenario bundles are already recorded under
# data/bundles/, so a recorded bundle keeps the whole UI working.
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=

# ELMFIRE fire-spread simulation behind GET /fire/arrival-grid (self-hosted; no
# credentials). The static tier comes from scripts/setup_fire_data.sh; until it
# exists the route answers 503 and /health reports fire_spread "no data".
# Pipeline mode served by default: tuned (our Mediterranean/Catalan model knobs,
# fire_spread/modes.py) or base (stock ELMFIRE physics on the same data). A
# request can pick the other with ?mode=; scripts/evaluate_fire_spread.sh
# scores both against historical fires.
PIPELINE_MODE=tuned
# Open-Meteo commercial API key (open-meteo.com/en/pricing). Leave empty for the
# free tier: 600 calls/min, 10 000/day per IP, where one simulation costs ~50-100
# weighted calls. Identical live requests are served from a 10-minute cache
# (WEATHER_CACHE_TTL_S); past weather for hindcasts/evaluation is cached on disk
# for good (WEATHER_CACHE_DIR, data/fire_spread/weather_cache), so only the first
# evaluation of a fire set spends quota.
OPEN_METEO_API_KEY=
# MPI ranks per simulation (cores to give ELMFIRE).
ELMFIRE_NPROC=4
# Keep ELMFIRE run directories under data/fire_spread/runs: all | failed | none
KEEP_RUNS=failed
# Simulations run at once; extra requests wait ACQUIRE_TIMEOUT_S then get 503.
MAX_CONCURRENT_RUNS=1
# Static tier and run directories. docker-compose.yml overrides both with the
# in-container paths; these are for running the API or the CLI on the host.
DATA_DIR=data/fire_spread/catalonia
RUNS_DIR=data/fire_spread/runs

# ---------------------------------------------------------- decision layer --
# Everything below is optional: /api runs on defaults without any of it.

# Nebius Token Factory, for the trilingual briefings. Leave empty to use the
# deterministic template briefings, which are valid by construction.
NEBIUS_API_KEY=
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Overpass mirrors for the named critical facilities (hospitals, schools,
# substations...), as a JSON array, tried in order. Leave empty for the
# provider's built-in list.
#
# Worth pinning when the default mirror is unreachable — but only to a mirror
# carrying PLANET-WIDE data. A regional mirror answers a Catalonia query with
# HTTP 200 and zero results, which is indistinguishable from "there is no
# hospital here", and the ranking quietly loses every named asset.
# OVERPASS_URLS=["https://overpass.kumi.systems/api"]

# Metres of slack around the outermost arrival contour when choosing which
# assets to score. Assets the fire never reaches score exactly zero, so a wide
# margin costs response size and buys nothing.
# REACHED_MARGIN_M=1000
