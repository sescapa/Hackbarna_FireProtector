data/fire_spread/

# Decision-layer runtime state under data/.
#
# Recorded scenario bundles are NOT ignored: committing one is what makes the
# UI demonstrable without Deepfire credentials. Caches and logs are.
data/cache/
data/logs/

# osmnx's own HTTP cache of Overpass responses.
cache/
