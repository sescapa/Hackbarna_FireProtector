.venv/
scripts/.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/

# Loader staging area (CSV batches, deleted as they are loaded)
db/import/*
!db/import/.gitkeep

# ELMFIRE static tier, source downloads, run directories, hindcast results
